<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.insurancemanagementsystem.mapper.UserMapper">

 <resultMap id="userMap"
            type="com.crimsonlogic.insurancemanagementsystem.model.User">

  <id property="id" column="id"/>
  <result property="name" column="name"/>
  <result property="username" column="username"/>
  <result property="password" column="password"/>
  <result property="email" column="email"/>
  <result property="phone" column="phone"/>
  <result property="role" column="role"/>
  <result property="status" column="status"/>

  <discriminator
          javaType="com.crimsonlogic.insurancemanagementsystem.enums.Role"
          column="role">

   <case value="ADMIN"
         resultType="com.crimsonlogic.insurancemanagementsystem.model.Admin"/>

   <case value="EMPLOYEE"
         resultType="com.crimsonlogic.insurancemanagementsystem.model.Employee"/>

   <case value="AGENT"
         resultType="com.crimsonlogic.insurancemanagementsystem.model.Agent"/>

   <case value="CUSTOMER"
         resultType="com.crimsonlogic.insurancemanagementsystem.model.Customer">
    <result property="age" column="age"/>
   </case>

  </discriminator>

 </resultMap>


 <select id="findByUsername" resultMap="userMap">
  SELECT *
  FROM users
  WHERE username = #{username}
  AND password = #{password}
  AND status = 'ACTIVE'
 </select>


 <select id="findById" resultMap="userMap">
  SELECT *
  FROM users
  WHERE id = #{id}
 </select>


 <select id="findAll" resultMap="userMap">
  SELECT *
  FROM users
  ORDER BY role, name
 </select>


 <select id="countByUsername" resultType="int">
  SELECT COUNT(*)
  FROM users
  WHERE username = #{username}
 </select>


 <insert id="insertUser">
  INSERT INTO users
  (id, name, username, password, email, phone, role, status, age)
  VALUES
  (#{id}, #{name}, #{username}, #{password}, #{email}, #{phone},
  #{role}, #{status}, #{age})
 </insert>


 <update id="updateStatus">
  UPDATE users
  SET status = #{status}
  WHERE id = #{id}
 </update>


 <select id="findLastUserNumber"
         parameterType="string"
         resultType="java.lang.Integer">

  SELECT COALESCE(
  MAX(
  CAST(
  SUBSTRING(
  id,
  CHAR_LENGTH(#{prefix}) + 1
  ) AS UNSIGNED
  )
  ),
  0
  )
  FROM users
  WHERE id LIKE CONCAT(#{prefix}, '%')

 </select>


 <select id="findActiveAgents"
         resultMap="userMap">

  SELECT
  id,
  name,
  username,
  password,
  email,
  phone,
  role,
  status
  FROM users
  WHERE role = 'AGENT'
  AND status = 'ACTIVE'
  ORDER BY name

 </select>

</mapper>