<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crimsonlogic.insurancemanagementsystem.mapper.PaymentMapper">
<insert id="insert">INSERT INTO payments(id,policy_id,customer_id,amount,method,status,paid_at) VALUES(#{id},#{policyId},#{customerId},#{amount},#{method},#{status},#{paidAt})</insert>
<select id="findByCustomer" resultType="Payment">SELECT * FROM payments WHERE customer_id=#{customerId} ORDER BY paid_at DESC</select>
</mapper>
